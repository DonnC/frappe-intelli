{
  "name": "frappe-intelli",
  "displayName": "Frappe Intelli",
  "description": "Frappe and ERPNext developer intelligence for VS Code: DocType completions, field completions, snippets, jump-to-source, diagnostics, and bench commands.",
  "version": "0.2.0",
  "publisher": "DonnC",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "frappe",
    "erpnext",
    "bench",
    "doctype",
    "intellisense"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:json",
    "onCommand:frappe-intelli.reloadIndex",
    "onCommand:frappe-intelli.selectSite",
    "onCommand:frappe-intelli.openBenchConsole",
    "onCommand:frappe-intelli.runMigrate",
    "onCommand:frappe-intelli.clearCache",
    "onCommand:frappe-intelli.restartBench",
    "onCommand:frappe-intelli.buildAssets",
    "onCommand:frappe-intelli.watchAssets",
    "onCommand:frappe-intelli.runCurrentTest",
    "onCommand:frappe-intelli.openDoctypeJson",
    "onCommand:frappe-intelli.openController",
    "onCommand:frappe-intelli.createPatch",
    "onCommand:frappe-intelli.showIndexStatus",
    "onView:frappe-intelli.benchExplorer"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "Frappe Intelli",
      "properties": {
        "frappeIntelli.benchPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a Frappe bench. Leave empty to auto-detect from the workspace."
        },
        "frappeIntelli.defaultSite": {
          "type": "string",
          "default": "",
          "description": "Default site used by bench commands. Leave empty to pick from sites/."
        },
        "frappeIntelli.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable Frappe-specific diagnostics for patches, translations, hooks, and likely field references."
        },
        "frappeIntelli.indexCustomAppsOnly": {
          "type": "boolean",
          "default": false,
          "description": "Index only custom apps listed after frappe/erpnext in sites/apps.txt."
        },
        "frappeIntelli.indexWhitelistedMethodsOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only suggest Python functions decorated with @frappe.whitelist() as dotted method completions."
        }
      }
    },
    "commands": [
      {
        "command": "frappe-intelli.reloadIndex",
        "title": "Frappe Intelli: Reload Bench Index"
      },
      {
        "command": "frappe-intelli.selectSite",
        "title": "Frappe Intelli: Select Site"
      },
      {
        "command": "frappe-intelli.openBenchConsole",
        "title": "Frappe Intelli: Open Bench Console"
      },
      {
        "command": "frappe-intelli.runMigrate",
        "title": "Frappe Intelli: Run Migrate"
      },
      {
        "command": "frappe-intelli.clearCache",
        "title": "Frappe Intelli: Clear Cache"
      },
      {
        "command": "frappe-intelli.restartBench",
        "title": "Frappe Intelli: Restart Bench"
      },
      {
        "command": "frappe-intelli.buildAssets",
        "title": "Frappe Intelli: Build Assets"
      },
      {
        "command": "frappe-intelli.watchAssets",
        "title": "Frappe Intelli: Watch Assets"
      },
      {
        "command": "frappe-intelli.runCurrentTest",
        "title": "Frappe Intelli: Run Current Test"
      },
      {
        "command": "frappe-intelli.openDoctypeJson",
        "title": "Frappe Intelli: Open Current DocType JSON"
      },
      {
        "command": "frappe-intelli.openController",
        "title": "Frappe Intelli: Open Current Controller"
      },
      {
        "command": "frappe-intelli.createPatch",
        "title": "Frappe Intelli: Create Patch"
      },
      {
        "command": "frappe-intelli.showIndexStatus",
        "title": "Frappe Intelli: Show Index Status"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "frappe-intelli.reloadIndex"
        },
        {
          "command": "frappe-intelli.selectSite"
        },
        {
          "command": "frappe-intelli.openBenchConsole"
        },
        {
          "command": "frappe-intelli.runMigrate"
        },
        {
          "command": "frappe-intelli.clearCache"
        },
        {
          "command": "frappe-intelli.restartBench"
        },
        {
          "command": "frappe-intelli.buildAssets"
        },
        {
          "command": "frappe-intelli.watchAssets"
        },
        {
          "command": "frappe-intelli.runCurrentTest"
        },
        {
          "command": "frappe-intelli.openDoctypeJson"
        },
        {
          "command": "frappe-intelli.openController"
        },
        {
          "command": "frappe-intelli.createPatch"
        },
        {
          "command": "frappe-intelli.showIndexStatus"
        }
      ]
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/python.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "json",
        "path": "./snippets/json.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frappe-intelli",
          "title": "Frappe",
          "icon": "resources/frappe-intelli.svg"
        }
      ]
    },
    "views": {
      "frappe-intelli": [
        {
          "id": "frappe-intelli.benchExplorer",
          "name": "Bench Explorer"
        }
      ]
    }
  },
  "scripts": {
    "lint": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "package": "npx @vscode/vsce package",
    "install:local": "code --install-extension frappe-intelli-0.2.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DonnC/frappe-intelli.git"
  },
  "bugs": {
    "url": "https://github.com/DonnC/frappe-intelli/issues"
  },
  "homepage": "https://github.com/DonnC/frappe-intelli#readme"
}
